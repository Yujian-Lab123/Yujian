# ============ 遇见 环境变量示例 ============
# 复制为 .env.local 后填写。所有密钥只放服务器端，绝不进前端/Git。

# ---- PostgreSQL（npm run bootstrap 会启动对应 Docker 容器）----
DATABASE_URL=postgresql://yujian:yujian_dev@localhost:54329/yujian
# OAuth token 加密密钥；启用真实 OAuth 前必须替换为随机长字符串
TOKEN_ENCRYPTION_KEY=local-dev-change-before-oauth
# 生产环境默认关闭任意 Mock 身份登录；比赛演示环境可显式设为 true
DEMO_AUTH_ENABLED=true

# ---- LLM（OpenAI 兼容协议，Qwen / MiMo / DeepSeek 均可）----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash
# 便宜层（画像引擎第一阶段提取使用；留空则与 LLM_MODEL 相同）
LLM_CHEAP_MODEL=qwen3.7-flash
# 可选：便宜层单独指定厂商（例如主模型用 MiMo-pro 综合，抽取走 DeepSeek 快模型）
# LLM_CHEAP_BASE_URL=https://api.deepseek.com/v1
# 换厂商示例：
#   DeepSeek：LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-reasoner  LLM_CHEAP_MODEL=deepseek-chat
#   通义：  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_CHEAP_MODEL=qwen3.7-flash
# 提示：推理模型（deepseek-reasoner/mimo）慢但深；抽取层建议用非推理快模型（deepseek-chat/qwen-flash）。
# 留空则使用 MockLLM（预制结构化输出，Demo 始终可跑）

# ---- Embedding（可选，留空用 Mock 轴向向量）----
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# ---- 知乎 OAuth（P2 已接入；四个变量齐备后 Landing 自动显示真实登录入口）----
# 三类凭证严格分开：App ID（公开标识）≠ OAuth App Key（换 Token）≠ Access Secret（调用户接口）
ZHIHU_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_ACCESS_SECRET=
# 必须与知乎开放平台登记值完全一致的公网 HTTPS 回调，如 https://your-domain.com/api/auth/callback
ZHIHU_REDIRECT_URI=
# 部署在反向代理后时填写对外origin（如 https://your-domain.com），用于拼接回调后的跳转
APP_ORIGIN=
# 仅在比赛方明确确认回调不返回 state 时临时开启；默认必须校验 state
ZHIHU_ALLOW_MISSING_STATE=false
