# ============ 遇见 环境变量示例 ============
# 复制为 .env.local 后填写。所有密钥只放服务器端，绝不进前端/Git。

# ---- LLM（OpenAI 兼容协议，mimo / DashScope / DeepSeek 均可）----
LLM_BASE_URL=https://api.mimo.ai/v1
LLM_API_KEY=
LLM_MODEL=mimo-pro
# 留空则使用 MockLLM（预制结构化输出，Demo 始终可跑）

# ---- Embedding（可选，留空用 Mock 轴向向量）----
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# ---- 知乎 OAuth（部署到公网后再填；本地 Demo 用 Mock）----
ZHIHU_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_ACCESS_SECRET=
ZHIHU_REDIRECT_URI=
